NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=0

MONGODB_URI=mongodb://clinicos_app:clinicos-app-local-only@localhost:27017/clinicos?authSource=clinicos
DEFAULT_CLINIC_ID=000000000000000000000001
CLINIC_TIMEZONE=Asia/Kolkata
REDIS_URL=redis://localhost:6379

APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost
JWT_SECRET=replace-with-at-least-64-random-characters-before-production
JWT_EXPIRES_IN=8h
SESSION_TTL_MINUTES=480
COOKIE_NAME=clinicos_session
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

SEED_ADMIN_NAME=Clinic Administrator
SEED_ADMIN_EMAIL=admin@clinic.local
SEED_ADMIN_PASSWORD=ChangeMe123!
