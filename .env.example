# Docker Compose defaults for local development only.
COMPOSE_PROJECT_NAME=clinicos
APP_PORT=80
MONGO_ROOT_USERNAME=clinicos
MONGO_ROOT_PASSWORD=clinicos-local-only
MONGO_APP_USERNAME=clinicos_app
MONGO_APP_PASSWORD=clinicos-app-local-only
MONGO_DATABASE=clinicos
MONGO_PORT=27017
REDIS_PORT=6379
CLINIC_TIMEZONE=Asia/Kolkata
JWT_SECRET=replace-with-at-least-64-random-characters-before-production
SEED_ADMIN_EMAIL=admin@clinic.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# OpenEMR is disabled until its OAuth/FHIR proof is complete.
OPENEMR_ENABLED=false
OPENEMR_BASE_URL=http://openemr
OPENEMR_TOKEN_URL=http://openemr/oauth2/default/token
OPENEMR_CLIENT_ID=
OPENEMR_CLIENT_SECRET=
OPENEMR_DB_ROOT_PASSWORD=openemr-local-root
OPENEMR_DB_USER=openemr
OPENEMR_DB_PASSWORD=openemr-local-only
OPENEMR_ADMIN_USER=admin
OPENEMR_ADMIN_PASSWORD=ChangeOpenEMRNow!
OPENEMR_HTTP_PORT=8300
OPENEMR_HTTPS_PORT=9300
