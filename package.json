{
  "name": "clinicos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ClinicOS clinic-management platform for OpenEMR 8.x",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api,worker --prefix-colors cyan,green,yellow \"npm run dev --workspace @clinicos/web\" \"npm run dev --workspace @clinicos/api\" \"npm run dev --workspace @clinicos/worker\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:check": "npm audit --omit=dev --audit-level=high && npm run format:check && npm run lint && npm test",
    "test": "npm run test --workspaces --if-present",
    "smoke:workflow": "node scripts/workflow-smoke.js",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "services:up": "node scripts/compose.js up -d mongo redis",
    "services:status": "node scripts/compose.js ps",
    "services:down": "node scripts/compose.js down",
    "compose:up": "node scripts/compose.js up --build",
    "compose:down": "node scripts/compose.js down",
    "compose:config": "node scripts/compose.js config --quiet",
    "seed:admin": "npm run seed:admin --workspace @clinicos/api",
    "db:indexes": "npm run db:indexes --workspace @clinicos/api",
    "mongo:provision": "node scripts/provision-mongo-user.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  }
}
